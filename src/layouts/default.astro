---
import '../styles/estilo.css'
import  Navegacion  from '../components/Navegacion.astro'
import Pie  from '../components/Pie.astro'

const {titulo}= Astro.props
---

<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{titulo} - Archivo Resident Evil</title>
        <meta name="description" content="Enciclopedia sobre la saga Resident Evil. susu entregas y protagonistas.">
        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700&family=Oswald:wght@700&display=swap" rel="stylesheet">
    </head>
    <body>
        <Navegacion />
        <main>
            <slot />
        </main>
        <Pie/>
    </body>
</html>